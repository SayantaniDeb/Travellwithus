# Server-only configuration. Never prefix provider or admin secrets with VITE_.
GROQ_API_KEY=
OPENAI_API_KEY=
OPENWEATHER_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Exact frontend origins, comma-separated. Add your actual deployed frontend URL.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://travellwith02.netlify.app
# Optional: admin/debug routes return 403 unless this server-only key is configured.
ADMIN_API_KEY=

# Photo moderation remains disabled until the server credentials and rules are configured.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_STORAGE_BUCKET=
COMMUNITY_IMAGE_RULES_CONFIRMED=false
